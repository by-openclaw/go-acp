# Binaries — ignore build output, but allow vendor tools under per-protocol
# assets (internal/<proto>/assets/).
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.syso
!internal/**/assets/**/*.exe
!internal/**/assets/**/*.dll
!internal/**/assets/**/*.so
!internal/**/assets/**/*.dylib

# Cross-compiled dhs binary staged into AMWA harness build context.
# Re-built by `GOOS=linux GOARCH=amd64 go build -o tests/integration/nmos/amwa/dhs ./cmd/dhs`
# before each `docker compose build`.
tests/integration/nmos/amwa/dhs

# Go build cache
*.test
*.out
*.prof
*.cov
coverage.html

# Local session scratch (audit notes, commit-message drafts, handoffs).
# Working files only — anything durable graduates into docs/ or a memory.
/.audit/

# IDE
.idea/
.vscode/
.claude/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets — never commit
.secrets/
*.pem
*.key
.env
.env.*
# Interim ansible credential store (pre-vault). Only the .example is committed.
ansible/secrets/*.json
!ansible/secrets/*.example.json
ansible/secrets/*.vault

# Temp
/tmp/

# Node.js test-harness installs (internal/**/test-harness/node_modules).
# Dependencies are pinned via package.json + package-lock.json and
# re-installed by .devcontainer/post-create.sh on container build.
**/node_modules/

# Legacy code from dhs 2016 era — scheduled removal after per-connector
# DoD (ADR-0025). Local working copies stay untracked; the README at
# the top of /legacy/ is the only tracked file documenting what was here.
/legacy/*
!/legacy/README.md

# Local capture files produced by --capture. Default: ignore every
# .jsonl wire trace. Small hand-trimmed JSONL test fixtures kept under
# internal/<proto>/testdata/fixtures/ are explicitly re-included
# (golden compliance fixtures, never live captures).
*.jsonl
!internal/**/testdata/fixtures/*.jsonl
!internal/**/testdata/protocol_types/**/*.jsonl
!internal/**/testdata/scenarios/**/*.jsonl
!internal/**/testdata/replay/**/*.jsonl
# Real-device announce recordings the producer loops via
# --announce-replay (liveness emulation; extracted from a walk capture,
# LOGIN-free ACP2 payloads only).
!internal/**/testdata/**/announces/*.jsonl
!tests/fixtures/**/*.jsonl
# ADR-0020 Bucket 5 (amendment 2026-06-24): one full real-device decoder
# oracle per protocol is committed under
# internal/<proto>/testdata/fixtures/<device>/ to enrich the codec
# regression with ground-truth device bytes (acp1/acp2/emberplus/probel).
# Scratch --capture output under the repo-root captures/ tree stays ignored.
!internal/**/testdata/fixtures/**/*.jsonl

# ADR-0020 Bucket 4: cache + manual capture archive at repo root.
# Both gitignored — wire traces are LOCAL ONLY (no LFS, no committed
# blobs, per ADR-0021). Cache regenerates from each walk; captures stay
# local for offline replay. /captures/ uses /* + ! exception so the
# README is committable (git negation can't re-include a child if the
# parent dir is excluded).
/.cache/
/captures/*
!/captures/README.md

# ADR-0028 operator bucket: state snapshots written by the defaulted
# export verbs (snapshots/<proto>/<ip>/<facet>). Working artifacts stay
# local; CURATED copies live under internal/<proto>/testdata/.
/snapshots/

# Root-level assets/ is reserved as a scratch dir for ad-hoc debug /
# validation runs. Real spec assets live under internal/<proto>/assets/.
/assets/

# Stale per-protocol test-data dumps. None of these are loaded by any
# test; pure blob bloat. Per ADR-0021 wire traces stay local under
# captures/, never under testdata/.
internal/acp1/testdata/exports/*.json
internal/acp2/testdata/exports/*.json
internal/acp2/testdata/fixtures/slot0.json
internal/acp2/testdata/fixtures/slot1.json
internal/acp2/testdata/fixtures/slot1_walk.json
internal/emberplus/testdata/fixtures/[0-9]*/tree.json
internal/emberplus/testdata/fixtures/[0-9]*/glow.json
internal/emberplus/testdata/fixtures/[0-9]*/raw.s101.jsonl

# raw infra configs (public repo - never commit running-configs)
/network/
