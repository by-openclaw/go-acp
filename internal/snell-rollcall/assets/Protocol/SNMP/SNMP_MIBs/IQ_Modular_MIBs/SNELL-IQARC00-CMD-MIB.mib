		DESCRIPTION
				"TYPE: - Button
				 PAGE: - ARC
					PassCtrl  cmdID= 2207  value= 0  
					12F12->12P16Ctrl  cmdID= 2207  value= 1  
					12F12->14P16Ctrl  cmdID= 2207  value= 2  
					12F12->16F16Ctrl  cmdID= 2207  value= 3  
