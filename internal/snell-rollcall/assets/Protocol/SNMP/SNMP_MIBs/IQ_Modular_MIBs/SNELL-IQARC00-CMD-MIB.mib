	iqarc00ARC OBJECT-TYPE
		SYNTAX		INTEGER {
							val_PassCtrl(0),
							val_12F12_12P16Ctrl(1),
							val_12F12_14P16Ctrl(2),
							val_12F12_16F16Ctrl(3),
