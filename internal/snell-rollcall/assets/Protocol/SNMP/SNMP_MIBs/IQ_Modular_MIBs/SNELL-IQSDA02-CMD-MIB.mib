--          WSS Type is "ETSI"
--              : ETSI:Parity Error
--              : ETSI:Box 14:9 C
--              : ETSI:Box 14:9 Top
--              : ETSI:Box 16:9 Top
--              : ETSI:FF 16:9 Ana
--              : ETSI:FF 4:3
--              : ETSI:Box 16:9
--              : ETSI:Box > 16:9 C
--              : ETSI:FF4:3 SP 14:9C
--
--          WSS Type is "AFD" or "AFD and ScanSys"
--              : AFD0:CodedFrame
--              : AFD1:4:3
--              : AFD2:16:9
--              : AFD3:14:9
--              : AFD4:(AFD=4)
--              : AFD5:4:3 SP 14:9 C
--              : AFD6:16:9 SP 14:9 C
--              : AFD7:16:9 SP 4:3
-- Comments		:
--
---------------------------------------------------------------------------------------------------
