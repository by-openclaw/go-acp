---------------------------------------------------------------------------------------------------
--  Logging
--  (HEADER=VALUE)
--  Logging values are stored in the swCardEventLogTable, each OID entry represents each slot
--  position.  The indexing of the table works using the log header string. For example if the
--  header is "FAULT", the index OID starts with the length of the header ie 5, followed by the
--  ASCII values for each letter 70 65 85 76 84.
--  Index for "FAULT" .5.70.65.85.76.84
--  To OID for FAULT on slot 12 for swCardEventLogTable is 1.3.6.1.4.1.7995.2.6.1.1.12. 5.  70.65.85.76.84
--                                                         |-------base-----------|Slt|Len|-F--A--U--L--T-|
--  An SNMP GET on this OID will return the Log value associated with FAULT for slot 12 eg "NONE" (FAULT=NONE)
--
---------------------------------------------------------------------------------------------------
-- Header		: SN
--
-- MIB ref		: swCardEventLogSlotXX       .2.83.78
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.1.1.XX.2.83.78
-- Vary			: NO
--
-- Value(s)		: s36093244
--				:
-- Comments		: Serial Number of module
--
---------------------------------------------------------------------------------------------------
-- Header		: MSG
--
-- MIB ref		: swCardEventLogSlotXX       .3.77.83.71
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.1.1.XX.3.77.83.71
-- Vary			: YES
--
-- Value(s)		: UNIT PRESENT
--				: UNIT LOST
-- Comments		:
--
---------------------------------------------------------------------------------------------------
-- Header		: UPTIME
--
-- MIB ref		: swCardEventLogSlotXX       .6.85.80.84.73.77.69
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.1.1.XX.6.85.80.84.73.77.69
-- Vary			: YES
--
-- Value(s)		: 000:00:12:00
--				:
-- Comments		: Uptime Days:Hours:Mins:Sec
--
---------------------------------------------------------------------------------------------------
-- Header		: SESSIONS
--
-- MIB ref		: swCardEventLogSlotXX       .8.83.69.83.83.73.79.78.83
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.1.1.XX.8.83.69.83.83.73.79.78.83
-- Vary			: YES
--
-- Value(s)		: 0
--				:
-- Comments		: Number or current control sessions.
--
---------------------------------------------------------------------------------------------------
-- Header		: INPUT_1_VI
--
-- MIB ref		: swCardEventLogSlotXX       .10.73.78.80.85.84.95.49.95.86.73
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.1.1.XX.10.73.78.80.85.84.95.49.95.86.73
-- Vary			: YES
--
-- Value(s)		: -
--  Not available
--    =-
--
--  VI Type SMPTE selected
--    =SMPTE
--
--  VI Type is "AFD:SMPTE 2016" selected
--  input is 4x3
--    =AFD:LB 16:9 Top
--    =AFD:LB 14:9 Top
--    =AFD:LB > 16:9 VC
--    =AFD:FF 4:3
--    =AFD:LB 16:9 VC
--    =AFD:LB 14:9 VC
--    =AFD:FF 4:3 alt 14:9 C
--    =AFD:LB 16:9 alt 14:9 C
--    =AFD:LB 16:9 alt 4: C
--
--  input is 16x9
--    =FF 16:9
--    =AFD:PB 14:9 HC
--    =AFD:LB > 16:9 VC
--    =AFD:FF 16:9
--    =AFD:PB 4:3 HC
--    =AFD:FF 16:9 Pro
--    =AFD:PB 14:9 HC
--    =AFD:PB 4:3 alt 14:9 C
--    =AFD:FF 16:9 alt 14:9 C
--    =AFD:FF 16:9 alt 4: C
--
--  VI Type is "Legacy AFD" or "Legacy AFD and ScanSys"
--    =AFD0:CodedFrame
--    =AFD1:4:3
--    =AFD2:16:9
--    =AFD3:14:9
--    =AFD4:(AFD=4)
--    =AFD5:4:3 SP 14:9 C
--    =AFD6:16:9 SP 14:9 C
--    =AFD7:16:9 SP 4:3
-- Comments		:
--
---------------------------------------------------------------------------------------------------
-- Header		: OS_VERSION
--
-- MIB ref		: swCardEventLogSlotXX       .10.79.83.95.86.69.82.83.73.79.78
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.1.1.XX.10.79.83.95.86.69.82.83.73.79.78
-- Vary			: YES
--
-- Value(s)		: V115 Release
--				:
-- Comments		:
--
---------------------------------------------------------------------------------------------------
-- Header		: ROL_STATES
--
-- MIB ref		: swCardEventLogSlotXX       .10.82.79.76.95.83.84.65.84.69.83
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.1.1.XX.10.82.79.76.95.83.84.65.84.69.83
-- Vary			: YES
--
-- Value(s)		: Disabled
--          No logging info
--              : -
--          No Errors found
--              : OK
--          List of failed RollTracks e.g.
--              : FAIL:1,3,5
-- Comments		:
--
---------------------------------------------------------------------------------------------------
