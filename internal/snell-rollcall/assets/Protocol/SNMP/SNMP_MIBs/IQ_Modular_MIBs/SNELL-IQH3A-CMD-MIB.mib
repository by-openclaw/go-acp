--
-- MIB ref		: swGatewayEventLogField  .12.84.69.77.80.95.49.95.83.84.65.84.69
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.2.1.1.12.84.69.77.80.95.49.95.83.84.65.84.69
-- Vary			: YES
--
-- Value(s)		: OK
--				: WARN:Low
--              : WARN:High
--              : FAIL:Low
--              : FAIL:High
--              : FAIL:Sensor Fault
-- Comments		: State of 1st Temperature monitor (In)
--              : OK Range    5C - 35C
--              : WARN:Low    0C -  5C
--              : WARN:High  35C - 40C
--              : FAIL:Low   < 0C
--              : FAIL:High  > 40C
--              : Note absolute values may vary in future releases, values are approximate
---------------------------------------------------------------------------------------------------
-- Header		: TEMP_2_STATE
--
-- MIB ref		: swGatewayEventLogField  .12.84.69.77.80.95.50.95.83.84.65.84.69
