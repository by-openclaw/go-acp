	iqsda11CmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF Iqsda11CmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQSDA11 1 }

	iqsda11CmdEntry OBJECT-TYPE
		SYNTAX		Iqsda11CmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqsda11SlotIndex }
		::= { iqsda11CmdTable 1 }

	Iqsda11CmdEntry ::=
		SEQUENCE {
			iqsda11SlotIndex
				Unsigned32,
			iqsda11RollTrackIndex
