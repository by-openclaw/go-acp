	iqd1lpgCmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF Iqd1lpgCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQD1LPG 1 }

	iqd1lpgCmdEntry OBJECT-TYPE
		SYNTAX		Iqd1lpgCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqd1lpgSlotIndex }
		::= { iqd1lpgCmdTable 1 }

	Iqd1lpgCmdEntry ::=
		SEQUENCE {
			iqd1lpgSlotIndex
				Unsigned32,
			iqd1lpg625
				INTEGER,
			iqd1lpg525
				INTEGER,
			iqd1lpgGenlockHPhase
				INTEGER,
			iqd1lpgGenlockVPhase
				INTEGER,
			iqd1lpgGenlock
				INTEGER,
			iqd1lpgBounce
				INTEGER,
			iqd1lpgSetupPresetUnit
				INTEGER,
			iqd1lpgSetupLoggingRefLoss
				INTEGER,
			iqd1lpgSetupSoftwareVersion
				RollCallString,
			iqd1lpgSetupSerialNo
				RollCallString
		}

	iqd1lpgSlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqd1lpgCmdEntry 0 }


