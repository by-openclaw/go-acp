                 TYPE: - RadiobuttonList
                 PAGE: - COM_PRIME_CFG_SAD
                    Information Window  cmdID= 3500
                    Input  value= 0
                    Output  value= 1  "
        ::= { iqasi82CmdEntry 3500 }


