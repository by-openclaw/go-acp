    iqasi82RollTrackSource OBJECT-TYPE
        SYNTAX            INTEGER {
                            valUnused(-1),
                            valInput1OK(0),
                            valInput1Fail(1),
                            valOutputAInput1(2),
                            valOutputAInput2(3),
                            valOutputAAuto(4),
                            valOutputASerial(5),
                            valOutputAExternal(6),
                            valOutputALocal(7),
                            valInput2OK(8),
                            valInput2Fail(9),
                            valOutputBInput1(10),
                            valOutputBInput2(11),
                            valOutputBAuto(12),
                            valOutputBSerial(13),
                            valOutputBExternal(14),
                            valOutputBLocal(15)
                            }
        MAX-ACCESS        read-write
        STATUS            current
        DESCRIPTION
                "CMNT: - Source for Rolltrack
                 TYPE: - RadiobuttonList
                 PAGE: - RollTrack
                    Source  cmdID= 36101
                    Unused  value= -1
                    Input 1 OK  value= 0
                    Input 1 Fail  value= 1
                    Output A = Input 1  value= 2
                    Output A = Input 2  value= 3
                    Output A = Auto  value= 4
                    Output A = Serial  value= 5
                    Output A = External  value= 6
                    Output A = Local  value= 7
                    Input 2 OK  value= 8
                    Input 2 Fail  value= 9
                    Output B = Input 1  value= 10
                    Output B = Input 2  value= 11
                    Output B = Auto  value= 12
                    Output B = Serial  value= 13
                    Output B = External  value= 14
                    Output B = Local  value= 15  "
        ::= { iqasi82CmdEntry 36101 }


