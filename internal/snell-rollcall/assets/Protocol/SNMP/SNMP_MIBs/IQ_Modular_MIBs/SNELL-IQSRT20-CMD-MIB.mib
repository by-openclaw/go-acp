		::= { moduleIQSRT20 1 }

	iqsrt20CmdEntry OBJECT-TYPE
		SYNTAX		Iqsrt20CmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqsrt20SlotIndex }
		::= { iqsrt20CmdTable 1 }

