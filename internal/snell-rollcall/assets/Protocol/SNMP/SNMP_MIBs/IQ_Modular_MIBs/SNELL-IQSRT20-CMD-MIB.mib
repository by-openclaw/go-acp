	iqsrt20SlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqsrt20CmdEntry 0 }


	iqsrt20InputSel OBJECT-TYPE
		SYNTAX		INTEGER {
							val_Select_1(0),
							val_Select_2(1),
							val_Select_3(2),
							val_Select_4(3)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - RadiobuttonList
					Input Sel  cmdID= 4 
					Select 1  value= 0  
					Select 2  value= 1  
					Select 3  value= 2  
					Select 4  value= 3  "
		::= { iqsrt20CmdEntry 4 }


	iqsrt20Display OBJECT-TYPE
		SYNTAX		INTEGER {
							val_Show_Status(0),
							val_Show_EDH_Stats(1),
							val_Show_RT_Errors(2)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Button
					Show Status  cmdID= 5  value= 0  
					Show EDH Stats  cmdID= 5  value= 1  
					Show RT Errors  cmdID= 5  value= 2  "
		::= { iqsrt20CmdEntry 5 }


