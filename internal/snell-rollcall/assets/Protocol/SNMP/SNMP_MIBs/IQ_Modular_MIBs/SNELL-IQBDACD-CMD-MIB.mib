	iqbdacdCmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF IqbdacdCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQBDACD 1 }

	iqbdacdCmdEntry OBJECT-TYPE
		SYNTAX		IqbdacdCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqbdacdSlotIndex }
		::= { iqbdacdCmdTable 1 }

	IqbdacdCmdEntry ::=
		SEQUENCE {
			iqbdacdSlotIndex
