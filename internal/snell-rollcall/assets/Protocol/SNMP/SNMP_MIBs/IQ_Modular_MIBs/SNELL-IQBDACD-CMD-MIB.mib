	iqbdacdSlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqbdacdCmdEntry 0 }


	iqbdacdChannel1Mute OBJECT-TYPE
		SYNTAX		INTEGER { disable(0), enable(1) }
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Checkbox
					Mute  cmdID= 6 "
		::= { iqbdacdCmdEntry 6 }


	iqbdacdChannel1Gain OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Number
					Gain  cmdID= 5  min= -1200  max= 0  step= 25  format= %1.2f dBu  div_scale= 100 
					Min = -12.00 dBu  Max = 0.00 dBu  Step = 0.25 dBu "
		::= { iqbdacdCmdEntry 5 }


