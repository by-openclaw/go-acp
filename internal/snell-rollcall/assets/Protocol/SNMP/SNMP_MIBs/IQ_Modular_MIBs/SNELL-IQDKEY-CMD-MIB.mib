				 PAGE: - Control
					Mix Level  cmdID= 2687  min= 0  max= 100  step= 1  format= %3.0f %%  div_scale= 1 
					Min =   0 %  Max = 100 %  Step =   1 % "
		::= { iqdkeyCmdEntry 2687 }


