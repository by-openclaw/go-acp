--				: FAIL
--				: RESET
-- Comments		: 
--
---------------------------------------------------------------------------------------------------
-- Header		: STD_FILL
--
-- MIB ref		: swCardEventLogSlotXX       .8.83.84.68.95.70.73.76.76
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.1.1.XX.8.83.84.68.95.70.73.76.76
