	iqdkeySlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqdkeyCmdEntry 0 }


	iqdkeyControlFadeEnable OBJECT-TYPE
		SYNTAX		INTEGER { disable(0), enable(1) }
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Checkbox
				 PAGE: - Control
					Fade Enable  cmdID= 2680 "
		::= { iqdkeyCmdEntry 2680 }


	iqdkeyControlFadeTime OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Number
				 PAGE: - Control
					Fade Time  cmdID= 2679  min= 0  max= 2047  step= 1  format= %4.0f Fields  div_scale= 1 
					Min =    0 Fields  Max = 2047 Fields  Step =    1 Fields "
		::= { iqdkeyCmdEntry 2679 }


	iqdkeyControlMixEnable OBJECT-TYPE
		SYNTAX		INTEGER { disable(0), enable(1) }
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
