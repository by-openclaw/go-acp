			iqbsynExtDelay1
				INTEGER,
			iqbsynExtDelay2
				INTEGER,
			iqbsynExtDelay3
				INTEGER,
			iqbsynExtDelay4
				INTEGER
		}

	iqbsynSlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqbsynCmdEntry 0 }


	iqbsynDisplay OBJECT-TYPE
		SYNTAX		INTEGER {
							val_Input_Output(5),
							val_Peak_Programme(7)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Button
					Input/Output  cmdID= 34  value= 5  
					Peak_Programme  cmdID= 34  value= 7  "
		::= { iqbsynCmdEntry 34 }


	iqbsynDisplayChannelStatusInf OBJECT-TYPE
		SYNTAX		INTEGER { disable(0), enable(1) }
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Checkbox
					Channel_Status_Inf  cmdID= 35 "
		::= { iqbsynCmdEntry 35 }


