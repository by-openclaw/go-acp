	iqbsynCmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF IqbsynCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQBSYN 1 }

	iqbsynCmdEntry OBJECT-TYPE
		SYNTAX		IqbsynCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqbsynSlotIndex }
		::= { iqbsynCmdTable 1 }

	IqbsynCmdEntry ::=
		SEQUENCE {
			iqbsynSlotIndex
				Unsigned32,
			iqbsynDisplay
