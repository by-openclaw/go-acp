	iqdsdesCmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF IqdsdesCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQDSDES 1 }

	iqdsdesCmdEntry OBJECT-TYPE
		SYNTAX		IqdsdesCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqdsdesSlotIndex }
		::= { iqdsdesCmdTable 1 }

	IqdsdesCmdEntry ::=
		SEQUENCE {
			iqdsdesSlotIndex
				Unsigned32,
			iqdsdesVideoInputStandard525
