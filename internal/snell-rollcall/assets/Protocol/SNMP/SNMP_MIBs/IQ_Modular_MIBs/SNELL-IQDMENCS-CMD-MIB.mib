		SYNTAX		IqdmencsCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqdmencsSlotIndex }
		::= { iqdmencsCmdTable 1 }

