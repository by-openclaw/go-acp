	iqdmencsSlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqdmencsCmdEntry 0 }


	iqdmencsStandard OBJECT-TYPE
		SYNTAX		INTEGER {
							val_PAL_NTSC(0),
							val_SECAM_NTSC(2)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - RadiobuttonList
					Standard  cmdID= 5 
					PAL/NTSC  value= 0  
					SECAM/NTSC  value= 2  "
		::= { iqdmencsCmdEntry 5 }


	iqdmencsGenlock OBJECT-TYPE
		SYNTAX		INTEGER {
							val_Internal(32),
							val_Zero_SC_H_Lock(0),
							val_Variable_SC_H_Lock(16)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Button
					Internal  cmdID= 6  value= 32  
					Zero_SC/H_Lock  cmdID= 6  value= 0  
					Variable_SC/H_Lock  cmdID= 6  value= 16  "
		::= { iqdmencsCmdEntry 6 }


	iqdmencsGenlockSCPhase OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Number
					SC_Phase  cmdID= 7  min= 0  max= 3599  step= 1  format= %1.1f Deg  div_scale= 10 
					Min = 0.0 Deg  Max = 359.9 Deg  Step = 0.1 Deg "
		::= { iqdmencsCmdEntry 7 }


	iqdmencsGenlockHPhase OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Number
					H_Phase  cmdID= 8  min= 0  max= 1  step= 1  format= %1.0f ns  div_scale= 1 
					Min = 0 ns  Max = 1 ns  Step = 1 ns "
		::= { iqdmencsCmdEntry 8 }


	iqdmencsGenlockFineHPhase OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - BarGraph
