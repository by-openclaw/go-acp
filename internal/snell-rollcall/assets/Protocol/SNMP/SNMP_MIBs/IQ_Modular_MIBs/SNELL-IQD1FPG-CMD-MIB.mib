	iqd1fpgCmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF Iqd1fpgCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQD1FPG 1 }

	iqd1fpgCmdEntry OBJECT-TYPE
		SYNTAX		Iqd1fpgCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqd1fpgSlotIndex }
		::= { iqd1fpgCmdTable 1 }

	Iqd1fpgCmdEntry ::=
		SEQUENCE {
			iqd1fpgSlotIndex
				Unsigned32,
			iqd1fpg625
				INTEGER,
			iqd1fpg525
				INTEGER,
			iqd1fpgGenlockHPhase
				INTEGER,
			iqd1fpgGenlockVPhase
				INTEGER,
			iqd1fpgGenlock
				INTEGER,
			iqd1fpgBounce
				INTEGER,
			iqd1fpgSetupPresetUnit
				INTEGER
		}

	iqd1fpgSlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqd1fpgCmdEntry 0 }


