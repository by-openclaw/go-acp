	iqd1fpgGenlockHPhase OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Number
					H_Phase  cmdID= 5  min= 0  max= 6400000  step= 3704  format= %.0f ns  div_scale= 100
					Min = 0 ns  Max = 64000 ns  Step = 37 ns "
		::= { iqd1fpgCmdEntry 5 }


	iqd1fpgGenlockVPhase OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Number
					V_Phase  cmdID= 6  min= 1  max= 625  step= 1  format= Line: %.0f  div_scale= 1
					Min = Line: 1  Max = Line: 625  Step = Line: 1 "
		::= { iqd1fpgCmdEntry 6 }


	iqd1fpgGenlock OBJECT-TYPE
		SYNTAX		INTEGER {
							val_Internal(0),
							val_Ext_Sync(1),
							val_Ext_Slave(2)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Button
					Internal  cmdID= 4  value= 0
					Ext_Sync  cmdID= 4  value= 1
					Ext_Slave  cmdID= 4  value= 2  "
		::= { iqd1fpgCmdEntry 4 }


	iqd1fpgBounce OBJECT-TYPE
