	iqd1adckCmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF Iqd1adckCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQD1ADCK 1 }

	iqd1adckCmdEntry OBJECT-TYPE
		SYNTAX		Iqd1adckCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqd1adckSlotIndex }
		::= { iqd1adckCmdTable 1 }

	Iqd1adckCmdEntry ::=
