				RollCallString
		}

	iqd1adckSlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqd1adckCmdEntry 0 }


	iqd1adckYGain OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - BarGraph
					Y_Gain  cmdID= 4  min= 0  max= 127   step= 1  format= %.0f  div_scale= 1 
					Min = 0  Max = 127  Step = 1 "
		::= { iqd1adckCmdEntry 4 }


	iqd1adckBlkLevel OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - BarGraph
					Blk_Level  cmdID= 6  min= 0  max= 63   step= 1  format= %.0f  div_scale= 1 
					Min = 0  Max = 63  Step = 1 "
		::= { iqd1adckCmdEntry 6 }


	iqd1adckPicPos OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Number
					Pic_Pos  cmdID= 8  min= -962  max= 962  step= 74  format= %1.0f ns  div_scale= 1 
					Min = -962 ns  Max = 962 ns  Step = 74 ns "
		::= { iqd1adckCmdEntry 8 }


