		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQCGPI 1 }

	iqcgpiCmdEntry OBJECT-TYPE
		SYNTAX		IqcgpiCmdEntry
