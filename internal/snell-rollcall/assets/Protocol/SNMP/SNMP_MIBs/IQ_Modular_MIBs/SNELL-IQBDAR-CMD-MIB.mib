	iqbdarSetGeneratorSetupLeftToneLeftFrequency OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Number
					Left_Frequency  cmdID= 42  min= 100  max= 22500  step= 100  format= %4.2fHz  div_scale= 1 
					Min = 100.00Hz  Max = 22500.00Hz  Step = 100.00Hz "
		::= { iqbdarCmdEntry 42 }


	iqbdarSetGeneratorSetupLeftToneLeftLevel OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Number
					Left_Level  cmdID= 40  min= -20  max= 0  step= 1  format= %1.0f dBFS  div_scale= 1 
					Min = -20 dBFS  Max = 0 dBFS  Step = 1 dBFS "
		::= { iqbdarCmdEntry 40 }


