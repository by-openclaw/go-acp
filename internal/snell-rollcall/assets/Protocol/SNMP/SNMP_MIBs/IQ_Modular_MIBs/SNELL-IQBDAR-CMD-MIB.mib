	iqbdarCmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF IqbdarCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQBDAR 1 }

	iqbdarCmdEntry OBJECT-TYPE
		SYNTAX		IqbdarCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqbdarSlotIndex }
		::= { iqbdarCmdTable 1 }

	IqbdarCmdEntry ::=
		SEQUENCE {
			iqbdarSlotIndex
				Unsigned32,
			iqbdarGenerator
				INTEGER,
			iqbdarDisplayChannelStatusInf
				INTEGER,
			iqbdarDisplayChannelStatusSetupUp
				INTEGER,
			iqbdarDisplayChannelStatusSetupDown
				INTEGER,
			iqbdarSetGeneratorSetupLeftTone
				INTEGER,
			iqbdarSetGeneratorSetupLeftToneLeftFrequency
				INTEGER,
			iqbdarSetGeneratorSetupLeftToneLeftLevel
				INTEGER,
			iqbdarSetGeneratorSetupRightTone
				INTEGER,
			iqbdarSetGeneratorSetupRightToneRightFrequency
				INTEGER,
			iqbdarSetGeneratorSetupRightToneRightLevel
				INTEGER,
			iqbdarSetGeneratorLockRightToLeft
				INTEGER,
			iqbdarLock
				INTEGER,
			iqbdarChannelStatEditChannelStatOrigin
				RollCallString,
			iqbdarChannelStatEditChannelStatDestination
				RollCallString,
			iqbdarMemoryRead
				INTEGER,
			iqbdarMemoryWrite
				INTEGER,
			iqbdarMemoryPreset
				INTEGER,
			iqbdarMemoryNamesMemory1
				RollCallString,
			iqbdarMemoryNamesMemory2
				RollCallString,
			iqbdarMemoryNamesMemory3
				RollCallString,
			iqbdarMemoryNamesMemory4
				RollCallString,
			iqbdarSetupSampleWordLength
				INTEGER,
			iqbdarSetupLoggingVideoRefChange
				INTEGER,
			iqbdarSetupLoggingAESRefChange
				INTEGER,
			iqbdarSetupPresetUnit
				INTEGER,
			iqbdarSetupSoftwareVersion
				RollCallString,
			iqbdarSetupSerialNo
				RollCallString
		}

	iqbdarSlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqbdarCmdEntry 0 }


	iqbdarGenerator OBJECT-TYPE
		SYNTAX		INTEGER { disable(0), enable(1) }
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Checkbox
					Generator  cmdID= 6 "
		::= { iqbdarCmdEntry 6 }


	iqbdarDisplayChannelStatusInf OBJECT-TYPE
		SYNTAX		INTEGER { disable(0), enable(1) }
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
