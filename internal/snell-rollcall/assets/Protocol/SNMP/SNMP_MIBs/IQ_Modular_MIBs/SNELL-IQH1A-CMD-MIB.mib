---------------------------------------------------------------------------------------------------
--  Logging
--  (HEADER=VALUE)
--  Logging values are stored in the swGatewayEventLogTable, swGatewayEventLogField represents the
--  table entry.  The indexing of the table works using the log header string. For example if the
--  header is "FAULT", the index OID starts with the length of the header ie 5, followed by the
--  ASCII values for each letter 70 65 85 76 84.
--  Index for "FAULT" .5.70.65.85.76.84
--  To OID for FAULT on slot 12 for swGatewayEventLogTable is 1.3.6.1.4.1.7995.2.6.2.1. 5.  70.65.85.76.84
--                                                         |-------base---------------|Len|-F--A--U--L--T-|
--  An SNMP GET on this OID will return the Log value associated with FAULT for gateway eg "NONE" (FAULT=NONE)
--
---------------------------------------------------------------------------------------------------
-- Header		: SN
--
-- MIB ref		: swGatewayEventLogField  .2.83.78
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.2.1.2.83.78
-- Vary			: NO
--
-- Value(s)		: S35063213
--				:
-- Comments		: Serial Number, Alpha-numberic string
--
---------------------------------------------------------------------------------------------------
-- Header		: FAULT
--
-- MIB ref		: swGatewayEventLogField  .5.70.65.85.76.84
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.2.1.5.70.65.85.76.84
-- Vary			: YES
--
-- Value(s)		: None
--              : FAIL:MODULE_COMMS
-- Comments		:
--              : FAIL:MODULE_COMMS, backplane comms severely errored, receiver now disabled.
--
---------------------------------------------------------------------------------------------------
-- Header		: UPTIME
--
-- MIB ref		: swGatewayEventLogField  .6.85.80.84.73.77.69
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.2.1.6.85.80.84.73.77.69
-- Vary			: YES
--
-- Value(s)		: 000:00:02:00
--				:
-- Comments		: System uptime, updated at regular intervals (60sec), format ddd:hh:mm:ss
--              : ddd=days, hh=hours, mm=minutes, ss=seconds
--
---------------------------------------------------------------------------------------------------
-- Header		: VERSION
--
-- MIB ref		: swGatewayEventLogField  .7.86.69.82.83.73.79.78
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.2.1.7.86.69.82.83.73.79.78
-- Vary			: NO
--
-- Value(s)		: 5.11 .14
--				:
-- Comments		: Version ID, software version, alpha-numeric string
--
---------------------------------------------------------------------------------------------------
-- Header		: IP_EVENT
--
-- MIB ref		: swGatewayEventLogField  .8.73.80.95.69.86.69.78.84
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.2.1.8.73.80.95.69.86.69.78.84
-- Vary			: YES
--
-- Value(s)		: 172.19.78.45 CONNECT FROM
--				: nnn.nnn.nnn.nnn CONNECT FROM
--				: nnn.nnn.nnn.nnn DISCONNECT FROM
--				: nnn.nnn.nnn.nnn BRIDGE CONNECT FROM
--				: nnn.nnn.nnn.nnn BRIDGE CONNECT TO
-- Comments		: Eg 172.19.23.1 CONNECT FROM
--              : Status log message only, signifying connection to or from a remote IP address.
--
---------------------------------------------------------------------------------------------------
-- Header		: LOCATION
--
-- MIB ref		: swGatewayEventLogField  .8.76.79.67.65.84.73.79.78
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.2.1.8.76.79.67.65.84.73.79.78
-- Vary			: YES
--
-- Value(s)		: Unknown
--				:
-- Comments		: String value denoting SNMP location.
--
---------------------------------------------------------------------------------------------------
-- Header		: SESSIONS
--
-- MIB ref		: swGatewayEventLogField  .8.83.69.83.83.73.79.78.83
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.2.1.8.83.69.83.83.73.79.78.83
-- Vary			: YES
--
-- Value(s)		: 1
--				: n
-- Comments		: n >= 0    Number of connected rollcall session
--
---------------------------------------------------------------------------------------------------
-- Header		: IPADDRESS
--
-- MIB ref		: swGatewayEventLogField  .9.73.80.65.68.68.82.69.83.83
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.2.1.9.73.80.65.68.68.82.69.83.83
-- Vary			: YES
--
-- Value(s)		: 172.19.81.51
--				:
-- Comments		: IP address of unit nnn.nnn.nnn.nnn  0 <= nnn <=255
--
---------------------------------------------------------------------------------------------------
-- Header		: SNMP_NAME
--
-- MIB ref		: swGatewayEventLogField  .9.83.78.77.80.95.78.65.77.69
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.2.1.9.83.78.77.80.95.78.65.77.69
-- Vary			: YES
--
-- Value(s)		: Unknown
--				:
-- Comments		: String value of SNMP name of unit
--
---------------------------------------------------------------------------------------------------
