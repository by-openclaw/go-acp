--
-- MIB ref		: swGatewayEventLogField  .10.80.83.85.95.50.95.78.65.77.69
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.2.1.10.80.83.85.95.50.95.78.65.77.69
