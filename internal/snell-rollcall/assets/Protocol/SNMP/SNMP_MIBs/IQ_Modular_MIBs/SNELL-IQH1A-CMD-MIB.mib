--
-- MIB ref		: swGatewayEventLogField  .10.70.65.78.95.52.95.78.65.77.69
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.2.1.10.70.65.78.95.52.95.78.65.77.69
