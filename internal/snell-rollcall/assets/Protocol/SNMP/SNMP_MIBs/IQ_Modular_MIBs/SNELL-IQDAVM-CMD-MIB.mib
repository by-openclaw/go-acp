	iqdavmSlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqdavmCmdEntry 0 }


	iqdavmExtractAnalogueOutputA OBJECT-TYPE
		SYNTAX		INTEGER {
							val_PAIR_1(0),
							val_PAIR_2(1),
							val_PAIR_3(2),
							val_PAIR_4(3),
							val_PAIR_5(4),
							val_PAIR_6(5),
							val_PAIR_7(6),
							val_PAIR_8(7),
							val_TONE(8),
							val_SILENCE(9)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - RadiobuttonList
					Analogue Output A  cmdID= 18 
					PAIR 1  value= 0  
					PAIR 2  value= 1  
					PAIR 3  value= 2  
					PAIR 4  value= 3  
					PAIR 5  value= 4  
					PAIR 6  value= 5  
					PAIR 7  value= 6  
					PAIR 8  value= 7  
					TONE  value= 8  
					SILENCE  value= 9  "
