	iqdavmCmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF IqdavmCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQDAVM 1 }

	iqdavmCmdEntry OBJECT-TYPE
		SYNTAX		IqdavmCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqdavmSlotIndex }
		::= { iqdavmCmdTable 1 }

	IqdavmCmdEntry ::=
		SEQUENCE {
			iqdavmSlotIndex
