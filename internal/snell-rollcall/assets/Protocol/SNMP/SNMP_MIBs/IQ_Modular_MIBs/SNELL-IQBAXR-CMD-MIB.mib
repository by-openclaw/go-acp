	iqbaxrCmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF IqbaxrCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQBAXR 1 }

	iqbaxrCmdEntry OBJECT-TYPE
		SYNTAX		IqbaxrCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqbaxrSlotIndex }
		::= { iqbaxrCmdTable 1 }

	IqbaxrCmdEntry ::=
		SEQUENCE {
			iqbaxrSlotIndex
				Unsigned32,
			iqbaxrOutputs
				INTEGER,
			iqbaxrOutputsAssign
				INTEGER,
			iqbaxrDisplay
				INTEGER,
			iqbaxrLRSwapOutputA
				INTEGER,
			iqbaxrLRSwapOutputB
				INTEGER,
			iqbaxrEDHShowStats
				INTEGER,
			iqbaxrEDHResetStats
				INTEGER,
			iqbaxrSetupLockToRef
				INTEGER,
			iqbaxrSetupSetDefaultOutput
				INTEGER,
			iqbaxrNamesOutputNamesOutputA
				RollCallString,
			iqbaxrNamesOutputNamesOutputB
				RollCallString,
			iqbaxrNamesInputNamesPair1
				RollCallString,
			iqbaxrNamesInputNamesPair2
				RollCallString,
			iqbaxrNamesInputNamesPair3
				RollCallString,
			iqbaxrNamesInputNamesPair4
				RollCallString,
			iqbaxrNamesInputNamesPair5
				RollCallString,
			iqbaxrNamesInputNamesPair6
				RollCallString,
			iqbaxrNamesInputNamesPair7
				RollCallString,
			iqbaxrNamesInputNamesPair8
				RollCallString,
			iqbaxrSetupNamesPresetNames
				INTEGER,
			iqbaxrSetupLoggingInputChange
				INTEGER,
			iqbaxrSetupLoggingD1AudioChange
				INTEGER,
			iqbaxrSetupLoggingEDHErrors
				INTEGER,
			iqbaxrSetupLoggingAESRefChange
				INTEGER,
			iqbaxrSetupPresetUnit
				INTEGER,
			iqbaxrSetupSoftwareVersion
				RollCallString,
			iqbaxrSetupSerialNo
				RollCallString
		}

	iqbaxrSlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqbaxrCmdEntry 0 }


	iqbaxrOutputs OBJECT-TYPE
		SYNTAX		INTEGER {
							val_Output_A(0),
							val_Output_B(1)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Button
					Output_A  cmdID= 31  value= 0  
					Output_B  cmdID= 31  value= 1  "
		::= { iqbaxrCmdEntry 31 }


	iqbaxrOutputsAssign OBJECT-TYPE
		SYNTAX		INTEGER {
							val_Pair_1(0),
							val_Pair_2(1),
							val_Pair_3(2),
							val_Pair_4(3),
							val_Pair_5(4),
							val_Pair_6(5),
							val_Pair_7(6),
							val_Pair_8(7),
							val_Tone(8),
							val_Silence(9)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - RadiobuttonList
					Assign  cmdID= 5 
					Pair_1  value= 0  
					Pair_2  value= 1  
					Pair_3  value= 2  
					Pair_4  value= 3  
					Pair_5  value= 4  
					Pair_6  value= 5  
					Pair_7  value= 6  
					Pair_8  value= 7  
					Tone  value= 8  
					Silence  value= 9  "
		::= { iqbaxrCmdEntry 5 }


	iqbaxrDisplay OBJECT-TYPE
		SYNTAX		INTEGER {
							val_Embedded_D1(0),
							val_AES_Outputs(1)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - RadiobuttonList
					Display  cmdID= 11 
					Embedded_D1  value= 0  
					AES_Outputs  value= 1  "
		::= { iqbaxrCmdEntry 11 }


