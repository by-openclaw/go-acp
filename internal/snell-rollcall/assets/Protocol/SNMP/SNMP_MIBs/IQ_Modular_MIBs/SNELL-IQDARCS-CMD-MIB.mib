	iqdarcsARC OBJECT-TYPE
		SYNTAX		INTEGER {
							val_PassCtrl(0),
							val_12F12_12P16Ctrl(1),
							val_12F12_14P16Ctrl(2),
							val_12F12_16F16Ctrl(3),
							val_16L12_12F12Ctrl(4),
							val_16L12_14L12Ctrl(5),
							val_16F16_12F12Ctrl(6),
							val_16F16_14L12Ctrl(7),
							val_16F16_16L12Ctrl(8)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Button
				 PAGE: - ARC
					PassCtrl  cmdID= 2207  value= 0  
					12F12->12P16Ctrl  cmdID= 2207  value= 1  
					12F12->14P16Ctrl  cmdID= 2207  value= 2  
					12F12->16F16Ctrl  cmdID= 2207  value= 3  
					16L12->12F12Ctrl  cmdID= 2207  value= 4  
					16L12->14L12Ctrl  cmdID= 2207  value= 5  
