	iqdarcsSlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqdarcsCmdEntry 0 }


	iqdarcsARCAspectCtrl OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Number
				 PAGE: - ARC
					AspectCtrl  cmdID= 2203  min= 501  max= 2000  step= 1  format= %1.3f  div_scale= 1000 
					Min = 0.501  Max = 2.000  Step = 0.001 "
		::= { iqdarcsCmdEntry 2203 }


