---------------------------------------------------------------------------------------------------
-- Header		: INPUT_1_WSS
--
-- MIB ref		: swCardEventLogSlotXX       .11.73.78.80.85.84.95.49.95.87.83.83
-- absolute OID	: 1.3.6.1.4.1.7995.2.6.1.1.XX.11.73.78.80.85.84.95.49.95.87.83.83
-- Vary			: YES
