--              : ETSI:Box 16:9 Top
--              : ETSI:FF 16:9 Ana
--              : ETSI:FF 4:3
--              : ETSI:Box 16:9
--              : ETSI:Box > 16:9 C
--              : ETSI:FF4:3 SP 14:9C
--
--          WSS Type is "AFD" or "AFD and ScanSys"
