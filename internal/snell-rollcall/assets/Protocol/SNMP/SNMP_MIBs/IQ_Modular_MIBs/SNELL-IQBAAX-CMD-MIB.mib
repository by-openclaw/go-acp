SNELL-IQBAAX-CMD DEFINITIONS ::= BEGIN

IMPORTS
    OBJECT-TYPE,
    NOTIFICATION-TYPE,
    MODULE-IDENTITY,
    OBJECT-IDENTITY,
    Counter32,
    Gauge32,
    Unsigned32
        FROM SNMPv2-SMI


    OBJECT-GROUP,
    MODULE-COMPLIANCE,
    AGENT-CAPABILITIES
        FROM SNMPv2-CONF

    RollCallString
        FROM SNELL-WILCOX-TC


    moduleIQBAAX,
    moduleIQBAAXMIB
        FROM SNELL-WILCOX-PRODUCT-REG;

 moduleIQBAAXCmdMi MODULE-IDENTITY
    LAST-UPDATED "0506101543Z"
    ORGANIZATION "Snell & Wilcox Ltd"
    CONTACT-INFO
