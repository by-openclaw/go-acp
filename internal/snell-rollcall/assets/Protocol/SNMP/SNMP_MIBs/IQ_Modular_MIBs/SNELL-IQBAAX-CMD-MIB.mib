	iqbaaxSlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqbaaxCmdEntry 0 }


	iqbaaxOutputsAnalogueOutputA OBJECT-TYPE
		SYNTAX		INTEGER {
							val_1_Group1_Pair_1(0),
							val_2_Group1_Pair_2(1),
							val_3_Group2_Pair_1(2),
							val_4_Group2_Pair_2(3),
							val_5_Group3_Pair_1(4),
							val_6_Group3_Pair_2(5),
							val_7_Group4_Pair_1(6),
							val_8_Group4_Pair_2(7),
							val_Tone(8),
							val_Silence(9)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - RadiobuttonList
					Analogue_Output_A  cmdID= 38
					1:Group1_Pair_1  value= 0
					2:Group1_Pair_2  value= 1
					3:Group2_Pair_1  value= 2
					4:Group2_Pair_2  value= 3
					5:Group3_Pair_1  value= 4
