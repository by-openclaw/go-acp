	iqbaaxCmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF IqbaaxCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQBAAX 1 }

	iqbaaxCmdEntry OBJECT-TYPE
		SYNTAX		IqbaaxCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqbaaxSlotIndex }
		::= { iqbaaxCmdTable 1 }

	IqbaaxCmdEntry ::=
		SEQUENCE {
			iqbaaxSlotIndex
