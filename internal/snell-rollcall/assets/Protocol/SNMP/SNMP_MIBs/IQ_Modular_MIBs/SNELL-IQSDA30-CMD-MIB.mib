    iqsda30SlotIndex OBJECT-TYPE
        SYNTAX            Unsigned32
        MAX-ACCESS        not-accessible
        STATUS            current
        DESCRIPTION
                "The unique Index value for each slot.  Its value
                ranges between 1 and the value of slotNumber."
        ::= { iqsda30CmdEntry 99999 }


    iqsda30Input1SDIRateInput1 OBJECT-TYPE
        SYNTAX            INTEGER {
                            valAuto(3),
                            valSDDVBnASI270Mb(0),
                            valHD15Gb(1),
                            val3G3Gb(2),
                            valReclockBypass(4)
                            }
        MAX-ACCESS        read-write
        STATUS            current
        DESCRIPTION
                "CMNT: - 
                 TYPE: - RadiobuttonList
                 PAGE: - Input 1
                    SDI Rate Input 1  cmdID= 4000
                    Auto  value= 3
                    SD/DVB-ASI (270 Mb)  value= 0
                    HD (1.5 Gb)  value= 1
                    3G (3Gb)  value= 2
                    Reclock Bypass  value= 4  "
        ::= { iqsda30CmdEntry 4000 }


    iqsda30Output1MuteOutput1 OBJECT-TYPE
        SYNTAX            INTEGER { disable(0), enable(1)  }
        MAX-ACCESS        read-write
