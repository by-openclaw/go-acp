	iqsda32SlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqsda32CmdEntry 0 }


	iqsda32Input1SDIRateInput1 OBJECT-TYPE
		SYNTAX		INTEGER {
							val_Auto(3),
							val_SD_DVB_ASI_270_Mb(0),
							val_HD_1_5_Gb(1),
							val_3G_3Gb(2),
							val_Reclock_Bypass(4)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - RadiobuttonList
					SDI Rate Input 1  cmdID= 4000 
					Auto  value= 3  
					SD/DVB-ASI (270 Mb)  value= 0  
					HD (1.5 Gb)  value= 1  
					3G (3Gb)  value= 2  
					Reclock Bypass  value= 4  "
		::= { iqsda32CmdEntry 4000 }


	iqsda32Output1MuteOutput1 OBJECT-TYPE
