				RollCallString
		}

	iqdearSlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqdearCmdEntry 0 }


	iqdearPairAExtractorA OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Number
					Extractor_A  cmdID= 13  min= 1  max= 8  step= 1  format= PAIR %0.0f  div_scale= 1 
					Min = PAIR 1  Max = PAIR 8  Step = PAIR 1 "
		::= { iqdearCmdEntry 13 }


