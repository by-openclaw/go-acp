	iqdearCmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF IqdearCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQDEAR 1 }

	iqdearCmdEntry OBJECT-TYPE
		SYNTAX		IqdearCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqdearSlotIndex }
		::= { iqdearCmdTable 1 }

	IqdearCmdEntry ::=
		SEQUENCE {
			iqdearSlotIndex
				Unsigned32,
			iqdearPairAExtractorA
				INTEGER,
			iqdearPairAEmbedderA
				INTEGER,
			iqdearPairBExtractorB
