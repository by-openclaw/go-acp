--				: FAIL:INPUT_A;INPUT_C
--				: FAIL:INPUT_A;INPUT_D
--				: FAIL:INPUT_B;INPUT_C
--				: FAIL:INPUT_B;INPUT_D
--				: FAIL:INPUT_C;INPUT_D
--				: FAIL:INPUT_A
--				: FAIL:INPUT_B
--				: FAIL:INPUT_C
--				: FAIL:INPUT_D
-- Comments		: 
--
---------------------------------------------------------------------------------------------------
