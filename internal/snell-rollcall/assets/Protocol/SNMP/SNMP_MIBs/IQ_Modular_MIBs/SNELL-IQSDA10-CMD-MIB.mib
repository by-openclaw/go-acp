	iqsda10CmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF Iqsda10CmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQSDA10 1 }

	iqsda10CmdEntry OBJECT-TYPE
		SYNTAX		Iqsda10CmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqsda10SlotIndex }
		::= { iqsda10CmdTable 1 }

	Iqsda10CmdEntry ::=
		SEQUENCE {
			iqsda10SlotIndex
				Unsigned32,
			iqsda10RollTrackIndex
				INTEGER,
			iqsda10RollTrackSource
				INTEGER,
			iqsda10RollTrackDisable
				INTEGER,
			iqsda10RollTrackAddress
				RollCallString,
			iqsda10RollTrackCommand
				RollCallString,
			iqsda10RollTrackSending
				RollCallString,
			iqsda10RollTrackStatus
				RollCallString,
			iqsda10RollTrackIndexB
				INTEGER,
			iqsda10RollTrackSourceB
				INTEGER,
			iqsda10RollTrackAddressB
				RollCallString,
			iqsda10RollTrackCommandB
				RollCallString,
			iqsda10LoggingInput1State
				INTEGER,
			iqsda10LoggingInput1RearLabel
				INTEGER,
			iqsda10LoggingInput1Type
				INTEGER,
			iqsda10LogStatusINPUT1TYPE
				RollCallString,
			iqsda10LogStatusINPUT1IDENT
				RollCallString,
			iqsda10LogStatusINPUT1STATE
				RollCallString,
			iqsda10UnitSoftwareVersion
				RollCallString,
			iqsda10UnitSerialNo
				RollCallString,
			iqsda10UnitRestart
				INTEGER,
			iqsda10UnitBuildNo
				RollCallString
		}

	iqsda10SlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqsda10CmdEntry 0 }


	iqsda10RollTrackIndex OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Number
				 PAGE: - RollTrack
					RollTrack Index  cmdID= 1495  min= 0  max= 15  step= 1  format= %.0f  div_scale= 1
					Min = 0  Max = 15  Step = 1 "
		::= { iqsda10CmdEntry 1495 }


	iqsda10RollTrackSource OBJECT-TYPE
		SYNTAX		INTEGER
		MAX-ACCESS		read-write
