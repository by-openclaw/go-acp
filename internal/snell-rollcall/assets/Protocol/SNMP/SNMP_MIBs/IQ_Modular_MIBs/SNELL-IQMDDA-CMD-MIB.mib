	iqmddaCmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF IqmddaCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQMDDA 1 }

	iqmddaCmdEntry OBJECT-TYPE
		SYNTAX		IqmddaCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqmddaSlotIndex }
		::= { iqmddaCmdTable 1 }

	IqmddaCmdEntry ::=
		SEQUENCE {
			iqmddaSlotIndex
				Unsigned32,
			iqmddaErrorsCurrIPStatus
				RollCallString,
			iqmddaErrorsShowIPStats
				INTEGER,
			iqmddaErrorsResetStats
				INTEGER,
			iqmddaGPIGPI1Mode
				INTEGER,
			iqmddaGPIGPI1ModeInvertGPI1Output
				INTEGER,
			iqmddaGPIGPI1ModeInvertGPI1Input
				INTEGER,
			iqmddaGPIGPI1ModeGPI1InputStatus
				RollCallString,
			iqmddaGPIGPI2Mode
				INTEGER,
			iqmddaGPIGPI2ModeInvertGPI2Output
				INTEGER,
			iqmddaGPIGPI2ModeInvertGPI2Input
				INTEGER,
			iqmddaGPIGPI2ModeGPI2InputStatus
				RollCallString,
			iqmddaInputs
				INTEGER,
			iqmddaInputsNewInputName
				RollCallString,
			iqmddaInputsInputStatus
				RollCallString,
			iqmddaSetupLoggingLogInputLoss
				INTEGER,
			iqmddaMemoriesSaveToMem1
				INTEGER,
			iqmddaMemoriesSaveToMem2
				INTEGER,
			iqmddaMemoriesSaveToMem3
				INTEGER,
			iqmddaMemoriesSaveToMem4
				INTEGER,
			iqmddaMemoriesRetrieveMem1
				INTEGER,
			iqmddaMemoriesRetrieveMem2
				INTEGER,
			iqmddaMemoriesRetrieveMem3
				INTEGER,
			iqmddaMemoriesRetrieveMem4
				INTEGER,
			iqmddaSetupMemoriesDefaultConfig
				INTEGER,
			iqmddaSetupSoftwareVersion
				RollCallString,
			iqmddaSetupSerialNo
				RollCallString,
			iqmddaSetupRestart
				INTEGER
		}

	iqmddaSlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqmddaCmdEntry 0 }


