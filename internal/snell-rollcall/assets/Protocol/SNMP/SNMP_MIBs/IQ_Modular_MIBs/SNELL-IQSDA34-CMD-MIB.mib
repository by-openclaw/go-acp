	iqsda34SlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqsda34CmdEntry 0 }


	iqsda34MenuChannel1SDIRateInput1 OBJECT-TYPE
		SYNTAX		INTEGER {
							val-Auto(3),
							val-SD-DVB-ASI-270-Mb(0),
							val-HD-1-5-Gb(1),
							val-3G-3Gb(2),
							val-Reclock-Bypass(4)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - RadiobuttonList
					SDI Rate Input 1  cmdID= 4000 
					Auto  value= 3  
					SD/DVB-ASI (270 Mb)  value= 0  
					HD (1.5 Gb)  value= 1  
