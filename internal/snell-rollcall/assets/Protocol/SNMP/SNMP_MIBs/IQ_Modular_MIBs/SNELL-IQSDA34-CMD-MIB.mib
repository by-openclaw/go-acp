							val-Input-1-Bitrate-3G(4),
							val-Input-1-Bitrate-Un(5),
							val-Input-2-OK(6),
							val-Input-2-None(7),
							val-Input-2-Bitrate-270(8),
							val-Input-2-Bitrate-1-5(9),
							val-Input-2-Bitrate-3G(10),
							val-Input-2-Bitrate-Un(11),
							val-Input-3-OK(12),
							val-Input-3-None(13),
							val-Input-3-Bitrate-270(14),
							val-Input-3-Bitrate-1-5(15),
							val-Input-3-Bitrate-3G(16),
							val-Input-3-Bitrate-Un(17),
							val-Chan-1-Output-Mute(18),
							val-Chan-1-Output-Pass(19),
							val-Chan-1-Output-Ok(20),
							val-Chan-2-Output-Mute(21),
							val-Chan-2-Output-Pass(22),
							val-Chan-2-Output-Ok(23),
							val-Chan-3-Output-Mute(24),
							val-Chan-3-Output-Pass(25),
