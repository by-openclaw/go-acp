							val-Chan-2-Input-2(27),
							val-Chan-2-Input-1(28),
							val-Chan-3-Input-3(29),
							val-Chan-3-Input-1(30)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - RadiobuttonList
				 PAGE: - RollTrack
					Source  cmdID= 36101 
					Unused  value= -1  
					Input 1 OK  value= 0  
					Input 1 None  value= 1  
					Input 1 Bitrate 270  value= 2  
					Input 1 Bitrate 1.5  value= 3  
					Input 1 Bitrate 3G  value= 4  
					Input 1 Bitrate Un.  value= 5  
					Input 2 OK  value= 6  
					Input 2 None  value= 7  
					Input 2 Bitrate 270  value= 8  
					Input 2 Bitrate 1.5  value= 9  
					Input 2 Bitrate 3G  value= 10  
					Input 2 Bitrate Un  value= 11  
					Input 3 OK  value= 12  
					Input 3 None  value= 13  
					Input 3 Bitrate 270  value= 14  
					Input 3 Bitrate 1.5  value= 15  
					Input 3 Bitrate 3G  value= 16  
					Input 3 Bitrate Un  value= 17  
					Chan 1 Output Mute  value= 18  
					Chan 1 Output Pass  value= 19  
					Chan 1 Output Ok  value= 20  
					Chan 2 Output Mute  value= 21  
					Chan 2 Output Pass  value= 22  
					Chan 2 Output Ok  value= 23  
					Chan 3 Output Mute  value= 24  
					Chan 3 Output Pass  value= 25  
					Chan 3 Output Ok  value= 26  
					Chan 2 Input 2  value= 27  
					Chan 2 Input 1  value= 28  
