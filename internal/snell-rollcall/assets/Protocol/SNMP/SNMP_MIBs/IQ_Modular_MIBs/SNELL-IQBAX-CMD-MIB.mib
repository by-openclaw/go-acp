	iqbaxCmdTable OBJECT-TYPE
		SYNTAX			SEQUENCE OF IqbaxCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Note the instance of this table is relected in the command set Version"
		::= { moduleIQBAX 1 }

	iqbaxCmdEntry OBJECT-TYPE
		SYNTAX		IqbaxCmdEntry
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"Entry in command table."
		INDEX	{ iqbaxSlotIndex }
		::= { iqbaxCmdTable 1 }

	IqbaxCmdEntry ::=
		SEQUENCE {
			iqbaxSlotIndex
