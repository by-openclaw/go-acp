	iqbaxSlotIndex OBJECT-TYPE
		SYNTAX		Unsigned32
		MAX-ACCESS		not-accessible
		STATUS			current
		DESCRIPTION
				"The unique Index value for each slot.  Its value
					ranges between 1 and the value of slotNumber."
		::= { iqbaxCmdEntry 0 }


	iqbaxOutputs OBJECT-TYPE
		SYNTAX		INTEGER {
							val_AES_Output_A(0),
							val_AES_Output_B(1),
							val_AES_Output_C(2),
							val_AES_Output_D(3)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - Button
					AES_Output_A  cmdID= 31  value= 0  
					AES_Output_B  cmdID= 31  value= 1  
					AES_Output_C  cmdID= 31  value= 2  
					AES_Output_D  cmdID= 31  value= 3  "
		::= { iqbaxCmdEntry 31 }


	iqbaxOutputsAssign OBJECT-TYPE
		SYNTAX		INTEGER {
							val_Pair_1(0),
							val_Pair_2(1),
							val_Pair_3(2),
							val_Pair_4(3),
							val_Pair_5(4),
							val_Pair_6(5),
							val_Pair_7(6),
							val_Pair_8(7),
							val_Tone(8),
							val_Silence(9)
							}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION
				"TYPE: - RadiobuttonList
					Assign  cmdID= 5 
					Pair_1  value= 0  
					Pair_2  value= 1  
					Pair_3  value= 2  
					Pair_4  value= 3  
					Pair_5  value= 4  
					Pair_6  value= 5  
					Pair_7  value= 6  
					Pair_8  value= 7  
					Tone  value= 8  
					Silence  value= 9  "
		::= { iqbaxCmdEntry 5 }


