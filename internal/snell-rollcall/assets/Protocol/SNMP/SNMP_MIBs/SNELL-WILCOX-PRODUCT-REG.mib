SNELL-WILCOX-PRODUCT-REG DEFINITIONS ::= BEGIN

IMPORTS
	MODULE-IDENTITY, OBJECT-IDENTITY
		FROM SNMPv2-SMI
	snellWilcoxProductReg,
	snellWilcoxMibReg
		FROM SNELL-WILCOX-SMI;


snellWilcoxProductMIB MODULE-IDENTITY
	LAST-UPDATED 	"1305161501Z"
	ORGANIZATION 	"Snell Group"
	CONTACT-INFO
		"Postal:	Snell Group
					Generic Software Group
					Southleigh Park House
					Eastleigh Road
					Havant
					Hants  PO9 2PE
					UK

		   Tel: 	+44 (0) 2392 489000

		E-mail: 	snmp.support@snellwilcox.com"

	DESCRIPTION		"This module defines the object identifiers that are
					assigned to individual products and hence are
					returned as values for sysObjectID"

    REVISION        "1305161501Z"
    DESCRIPTION     "Extra card definitions added"
    
	REVISION    	"0611071147Z"
	DESCRIPTION		"Extra card definitions added"

	REVISION    	"0501241400Z"
	DESCRIPTION		"Updated contact details"

	REVISION    	"0302241230Z"
	DESCRIPTION		"Initial version of this MIB module."
	::= { snellWilcoxProductReg 1 }


-- Product Line sub-trees

snellWilcoxControlSystems OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"Control systems providing remote control of Snell & Wilcox Products"
	::= { snellWilcoxProductReg 2 }

snellWilcoxModularProducts OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"Modular products"
	::= { snellWilcoxProductReg 3 }

snellWilcoxStdsConvertorProducts OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"Standards convertors"
	::= { snellWilcoxProductReg 4 }

snellWilcoxHdProducts OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"High Definition video products"
	::= { snellWilcoxProductReg 5 }

snellWilcoxMpegProducts OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"MPEG compression products"
	::= { snellWilcoxProductReg 6 }

snellWilcoxNoiseReductionProducts OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"Noise reduction products"
	::= { snellWilcoxProductReg 7 }

snellWilcoxImageRestorationProducts OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"Image restoration products"
	::= { snellWilcoxProductReg 8 }

snellWilcoxPostProductionProducts OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"Production and Post Production Products"
	::= { snellWilcoxProductReg 9 }

snellWilcoxDisplaysProducts OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"Display optimisation products"
	::= { snellWilcoxProductReg 10 }

snellWilcoxFileConversion OBJECT-IDENTITY
	STATUS 			current
	DESCRIPTION		"SNMP Values for the file conversion project."
	::= { snellWilcoxProductReg 11 }

snellWilcoxFileConversionSystem OBJECT IDENTIFIER
	::= { snellWilcoxFileConversion 1 }


-- Product Line  MIB sub-trees

snellWilcoxControlSystemsMib OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"Control systems providing remote control of Snell & Wilcox Products"
	::= { snellWilcoxMibReg 2 }

snellWilcoxModularProductsMib OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"Modular products"
	::= { snellWilcoxMibReg 3 }

snellWilcoxStdsConvertorProductsMib OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"Standards convertors"
	::= { snellWilcoxMibReg 4 }

snellWilcoxHdProductsMib OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"High Definition video products"
	::= { snellWilcoxMibReg 5 }

snellWilcoxMpegProductsMib OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"MPEG compression products"
	::= { snellWilcoxMibReg 6 }

snellWilcoxNoiseReductionProductsMib OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"Noise reduction products"
	::= { snellWilcoxMibReg 7 }

snellWilcoxImageRestorationProductsMib OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"Image restoration products"
	::= { snellWilcoxMibReg 8 }

snellWilcoxPostProductionProductsMib OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"Production and Post Production Products"
	::= { snellWilcoxMibReg 9 }

snellWilcoxDisplaysProductsMib OBJECT-IDENTITY
	STATUS			current
	DESCRIPTION		"Display optimisation products"
	::= { snellWilcoxMibReg 10 }


--  Control systems products
