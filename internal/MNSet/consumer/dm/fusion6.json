{
  "model": "FusioN6",
  "note": "Per-model dictionary: what the module does not publish. Every entry names its source; nothing is guessed. Patterns: '*' matches one path segment (a uuid, an index, a name); a leading '**' matches any number of leading segments.",
  "entries": [
    {"match": "**.dst_udp_port", "min": 1, "max": 65534, "description": "UDP destination port", "source": "mnset-ui validator Validators.min(1)/max(65534)"},
    {"match": "**.src_udp_port", "min": 1, "max": 65534, "description": "UDP source port", "source": "mnset-ui validator Validators.min(1)/max(65534)"},
    {"match": "self.syslog.config.port", "min": 1, "max": 65535, "description": "syslog collector UDP port", "source": "IANA port range"},
    {"match": "self.system.smpte_network.2022-7.class", "enum": {"a": "Class A (10 ms)", "b": "Class B (50 ms)", "d": "Class D (150 µs)"}, "description": "2022-7 Class (path differential tolerance)", "source": "mnset-ui enum list + label '2022-7 Class:'"},
    {"match": "**.network.pkt_cnt", "unit": "packets", "description": "Packet count on this leg since reset", "source": "mnset-ui label 'Packet count:'"},
    {"match": "**.network.*.pkt_cnt", "unit": "packets", "description": "Packet count on this leg since reset", "source": "mnset-ui label 'Packet count:'"},
    {"match": "**.rtp_stream_info.*.pkt_rate", "unit": "pkt/s", "description": "RTP packet rate on this leg", "source": "field name"},
    {"match": "**.rtp_stream_info.*.sequence_error", "unit": "packets", "description": "Packet Sync Errors on this leg", "source": "mnset-ui label 'Packet Sync Errors:'"},
    {"match": "**.rtp_stream_info.*.pkt_cnt", "unit": "packets", "description": "Packet count on this leg", "source": "mnset-ui label 'Packet count:'"},
    {"match": "port.*.sfp_ddm_info.temperature.*", "unit": "°C", "description": "SFP module temperature (DDM)", "source": "SFF-8472 DDM; mnset-ui label 'Temperature:'"},
    {"match": "port.*.sfp_ddm_info.vcc.*", "unit": "V", "description": "SFP supply voltage (DDM)", "source": "SFF-8472 DDM"},
    {"match": "self.system.core_temp", "unit": "°C", "description": "Core Temperature", "source": "mnset-ui label 'Core Temperature:'; same scale as the DDM temperatures"},
    {"match": "self.system.core_voltage", "description": "Core Voltage", "source": "mnset-ui label 'Core Voltage:' (unit not published)"},
    {"match": "telemetry.node.refclk.offset_from_master", "description": "PTP Offset from Master", "source": "mnset-ui label 'Offset from Master:' (unit not published)"},
    {"match": "telemetry.node.refclk.mean_delay", "description": "PTP Mean delay", "source": "mnset-ui label 'Mean delay:' (unit not published)"},
    {"match": "refclk.delay_req", "description": "PTP Delay Request interval (log2 seconds, IEEE 1588 logMinDelayReqInterval)", "source": "mnset-ui label 'Delay Request:'; IEEE 1588"},
    {"match": "telemetry.node.interfaces.e1.rx_bw", "description": "Primary RX Bandwidth", "source": "mnset-ui label (unit not published)"},
    {"match": "telemetry.node.interfaces.e1.tx_bw", "description": "Primary TX Bandwidth", "source": "mnset-ui label (unit not published)"},
    {"match": "telemetry.node.interfaces.e2.rx_bw", "description": "Secondary RX Bandwidth", "source": "mnset-ui label (unit not published)"},
    {"match": "telemetry.node.interfaces.e2.tx_bw", "description": "Secondary TX Bandwidth", "source": "mnset-ui label (unit not published)"},
    {"match": "telemetry.node.interfaces.oob.rx_bw", "description": "Management RX Bandwidth", "source": "mnset-ui label (unit not published)"},
    {"match": "telemetry.node.interfaces.oob.tx_bw", "description": "Management TX Bandwidth", "source": "mnset-ui label (unit not published)"},
    {"match": "clean_switch.*.clean_switch.igmp_setup_delay", "unit": "ms", "description": "Switching Defer Time", "source": "mnset-ui label 'Switching Defer Time (ms):'"},
    {"match": "sdi_output.*.line_offset.usec_offset", "unit": "µs", "description": "output timing offset", "source": "field name"},
    {"match": "sdi_output.*.line_offset.audio_delay", "description": "Audio delay", "source": "mnset-ui label 'Audio delay:' (unit not published)"},
    {"match": "sdi_output.*.line_offset.applied_audio_delay", "description": "Applied Audio delay", "source": "mnset-ui label 'Applied Audio delay:' (unit not published)"},
    {"match": "lldp.neighbor.*.ttl", "unit": "s", "description": "LLDP Neighbor TTL", "source": "mnset-ui label 'LLDP Neighbor TTL:'; IEEE 802.1AB TTL is seconds"},
    {"match": "flows.*.format.format_code_rate", "description": "video format code (rate part) — value_name is the format the six format_code_* select together; the enum lists every format this program accepts", "source": "mnset-ui VIDEO_FORMATS table"}
  ],
  "sibling_thresholds": [
    {"match": "port.*.sfp_ddm_info.*.current", "min_from": "low_alarm", "max_from": "high_alarm", "source": "module: the DDM alarm thresholds published next to the value"}
  ]
}
