{
 "model": "FusioN6",
 "note": "Per-model dictionary: what the module does not publish. Every entry names its source; nothing is guessed. Patterns: '*' matches one path segment (a uuid, an index, a name); a leading '**' matches any number of leading segments. Poll plan: on_change false on the health rows: a measurement is judged per sample (a counter that stopped, a link that is still down), a setting only when it changes.",
 "entries": [
  {
   "match": "**.dst_udp_port",
   "min": 1,
   "max": 65534,
   "description": "UDP destination port",
   "source": "mnset-ui validator Validators.min(1)/max(65534)"
  },
  {
   "match": "**.src_udp_port",
   "min": 1,
   "max": 65534,
   "description": "UDP source port",
   "source": "mnset-ui validator Validators.min(1)/max(65534)"
  },
  {
   "match": "self.syslog.config.port",
   "min": 1,
   "max": 65535,
   "description": "syslog collector UDP port",
   "source": "IANA port range"
  },
  {
   "match": "self.system.smpte_network.2022-7.class",
   "enum": {
    "a": "Class A (10 ms)",
    "b": "Class B (50 ms)",
    "d": "Class D (150 µs)"
   },
   "description": "2022-7 Class (path differential tolerance)",
   "source": "mnset-ui enum list + label '2022-7 Class:'"
  },
  {
   "match": "**.network.pkt_cnt",
   "access": "R",
   "unit": "packets",
   "description": "Packet count on this leg since reset",
   "source": "mnset-ui label 'Packet count:'"
  },
  {
   "match": "**.network.*.pkt_cnt",
   "access": "R",
   "unit": "packets",
   "description": "Packet count on this leg since reset",
   "source": "mnset-ui label 'Packet count:'"
  },
  {
   "match": "**.rtp_stream_info.*.status.pkt_rate",
   "access": "R",
   "unit": "pkt/s",
   "description": "RTP packet rate on this leg",
   "source": "field name"
  },
  {
   "match": "**.rtp_stream_info.*.status.sequence_error",
   "access": "R",
   "unit": "packets",
   "description": "Packet Sync Errors on this leg",
   "source": "mnset-ui label 'Packet Sync Errors:'"
  },
  {
   "match": "**.rtp_stream_info.*.status.pkt_cnt",
   "access": "R",
   "unit": "packets",
   "description": "Packet count on this leg",
   "source": "mnset-ui label 'Packet count:'"
  },
  {
   "match": "port.*.sfp_ddm_info.temperature.*",
   "unit": "°C",
   "description": "SFP module temperature (DDM)",
   "source": "SFF-8472 DDM; mnset-ui label 'Temperature:'"
  },
  {
   "match": "port.*.sfp_ddm_info.vcc.*",
   "unit": "V",
   "description": "SFP supply voltage (DDM)",
   "source": "SFF-8472 DDM"
  },
  {
   "match": "self.system.core_temp",
   "access": "R",
   "unit": "°C",
   "description": "Core Temperature",
   "source": "mnset-ui label 'Core Temperature:'; same scale as the DDM temperatures"
  },
  {
   "match": "self.system.core_voltage",
   "access": "R",
   "description": "Core Voltage",
   "source": "mnset-ui label 'Core Voltage:' (unit not published)"
  },
  {
   "match": "telemetry.node.refclk.offset_from_master",
   "description": "PTP Offset from Master",
   "source": "mnset-ui label 'Offset from Master:' (unit not published)"
  },
  {
   "match": "telemetry.node.refclk.mean_delay",
   "description": "PTP Mean delay",
   "source": "mnset-ui label 'Mean delay:' (unit not published)"
  },
  {
   "match": "refclk.delay_req",
   "description": "PTP Delay Request interval (log2 seconds, IEEE 1588 logMinDelayReqInterval)",
   "source": "mnset-ui label 'Delay Request:'; IEEE 1588"
  },
  {
   "match": "telemetry.node.interfaces.e1.rx_bw",
   "description": "Primary RX Bandwidth",
   "source": "mnset-ui label (unit not published)"
  },
  {
   "match": "telemetry.node.interfaces.e1.tx_bw",
   "description": "Primary TX Bandwidth",
   "source": "mnset-ui label (unit not published)"
  },
  {
   "match": "telemetry.node.interfaces.e2.rx_bw",
   "description": "Secondary RX Bandwidth",
   "source": "mnset-ui label (unit not published)"
  },
  {
   "match": "telemetry.node.interfaces.e2.tx_bw",
   "description": "Secondary TX Bandwidth",
   "source": "mnset-ui label (unit not published)"
  },
  {
   "match": "telemetry.node.interfaces.oob.rx_bw",
   "description": "Management RX Bandwidth",
   "source": "mnset-ui label (unit not published)"
  },
  {
   "match": "telemetry.node.interfaces.oob.tx_bw",
   "description": "Management TX Bandwidth",
   "source": "mnset-ui label (unit not published)"
  },
  {
   "match": "clean_switch.*.clean_switch.igmp_setup_delay",
   "unit": "ms",
   "description": "Switching Defer Time",
   "source": "mnset-ui label 'Switching Defer Time (ms):'"
  },
  {
   "match": "sdi_output.*.line_offset.usec_offset",
   "unit": "µs",
   "description": "output timing offset",
   "source": "field name"
  },
  {
   "match": "sdi_output.*.line_offset.audio_delay",
   "description": "Audio delay",
   "source": "mnset-ui label 'Audio delay:' (unit not published)"
  },
  {
   "match": "sdi_output.*.line_offset.applied_audio_delay",
   "access": "R",
   "description": "Applied Audio delay",
   "source": "mnset-ui label 'Applied Audio delay:' (unit not published)"
  },
  {
   "match": "lldp.neighbor.*.ttl",
   "unit": "s",
   "description": "LLDP Neighbor TTL",
   "source": "mnset-ui label 'LLDP Neighbor TTL:'; IEEE 802.1AB TTL is seconds"
  },
  {
   "match": "flows.*.format.format_code_rate",
   "description": "video format code (rate part) — value_name is the format the six format_code_* select together; the enum lists every format this program accepts",
   "source": "mnset-ui VIDEO_FORMATS table"
  },
  {
   "match": "self.system.fan_speed",
   "access": "R",
   "description": "fan speed (measured)",
   "source": "measured value; MN SET shows it read-only"
  },
  {
   "match": "self.system.uptime",
   "access": "R",
   "description": "uptime since boot",
   "source": "measured value"
  },
  {
   "match": "self.system.current_time",
   "access": "R",
   "description": "module clock",
   "source": "measured value"
  },
  {
   "match": "sdi_output.*.line_offset.status",
   "access": "R",
   "description": "line offset status",
   "source": "status field"
  },
  {
   "match": "clean_switch.*.clean_switch.status",
   "access": "R",
   "description": "clean switch status",
   "source": "status field"
  },
  {
   "match": "clean_switch.*.clean_switch.switch_time",
   "access": "R",
   "description": "clean switch: last switch time",
   "source": "status field"
  },
  {
   "match": "refclk.status",
   "access": "R",
   "description": "PTP lock status",
   "source": "status field"
  },
  {
   "match": "refclk.locked_interface",
   "access": "R",
   "description": "interface the PTP lock came from",
   "source": "status field"
  },
  {
   "match": "self.interfaces.*.current_ip",
   "access": "R",
   "description": "address in use (static_ip is the setting)",
   "source": "current_* vs static_* naming"
  },
  {
   "match": "self.interfaces.*.current_gateway",
   "access": "R",
   "description": "gateway in use (static_gateway is the setting)",
   "source": "current_* vs static_* naming"
  },
  {
   "match": "self.interfaces.*.mac_address",
   "access": "R",
   "description": "interface MAC",
   "source": "hardware identity"
  }
 ],
 "sibling_thresholds": [
  {
   "match": "port.*.sfp_ddm_info.*.current",
   "min_from": "low_alarm",
   "max_from": "high_alarm",
   "source": "module: the DDM alarm thresholds published next to the value"
  }
 ],
 "poll": {
  "defaults": {
   "interval": "60s"
  },
  "oids": [
   {
    "match": "**.network.pkt_cnt",
    "interval": "15s",
    "source": "stream presence: the counter must climb",
    "on_change": false
   },
   {
    "match": "**.network.*.pkt_cnt",
    "interval": "15s",
    "on_change": false
   },
   {
    "match": "**.rtp_stream_info.*.status.pkt_rate",
    "interval": "15s",
    "on_change": false
   },
   {
    "match": "**.rtp_stream_info.*.status.sequence_error",
    "interval": "15s",
    "on_change": false
   },
   {
    "match": "telemetry.node.**",
    "interval": "10s",
    "source": "health, links, PTP as the module summarises them",
    "on_change": false
   },
   {
    "match": "refclk.status",
    "interval": "10s",
    "on_change": false
   },
   {
    "match": "refclk.locked_interface",
    "interval": "10s",
    "on_change": false
   },
   {
    "match": "port.*.link",
    "interval": "10s",
    "on_change": false
   },
   {
    "match": "port.*.sfp_ddm_info.*.current",
    "interval": "30s",
    "on_change": false
   },
   {
    "match": "self.system.core_temp",
    "interval": "30s",
    "on_change": false
   },
   {
    "match": "self.system.fan_speed",
    "interval": "30s",
    "on_change": false
   },
   {
    "match": "flows.*.network.**",
    "interval": "60s",
    "source": "configuration drift"
   },
   {
    "match": "flows.*.format.**",
    "interval": "60s"
   },
   {
    "match": "self.ipconfig.**",
    "interval": "60s"
   },
   {
    "match": "self.interfaces.**",
    "interval": "60s"
   },
   {
    "match": "self.syslog.**",
    "interval": "60s"
   },
   {
    "match": "self.protocols.**",
    "interval": "60s"
   },
   {
    "match": "refclk.**",
    "interval": "60s"
   },
   {
    "match": "sdi_output.**",
    "interval": "60s"
   },
   {
    "match": "clean_switch.**",
    "interval": "60s"
   }
  ]
 }
}